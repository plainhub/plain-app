    <string name="onboarding_get_started">அமைவைத் தொடங்கு</string>
    <string name="onboarding_1_title">உங்கள் ஃபோனும் கணினியும், தனிப்பட்ட இணைப்பு</string>
    <string name="onboarding_1_body">ஒரே Wi-Fi-இல் கோப்புகளை அனுப்பவும், அரட்டை செய்யவும், ஃபோனை நிர்வகிக்கவும் — எல்லாமே உங்கள் சாதனங்களுக்குள்ளேயே.</string>
    <string name="onboarding_badge_no_account">கணக்கு தேவையில்லை</string>
    <string name="onboarding_badge_no_cloud">தரவு உங்கள் நெட்வொர்க்கிலேயே</string>
    <string name="onboarding_badge_no_ads">விளம்பரம் இல்லை</string>
    <string name="onboarding_2_title">கணினியிலிருந்து ஃபோனை நிர்வகிக்கவும்</string>
    <string name="onboarding_2_body">கணினி உலாவியில் ஒரு முகவரியைத் திறந்தால் போதும் — புகைப்படங்கள், வீடியோக்கள், கோப்பு பரிமாற்றம், கிளிப்போர்டு மற்றும் அறிவிப்புகள்.</string>
    <string name="onboarding_3_title">சாதனங்களுக்கு இடையே அரட்டை மற்றும் பரிமாற்றம்</string>
    <string name="onboarding_3_body">ஃபோன் மற்றும் கணினிக்கு இடையே அரட்டை செய்யவும், சேனல்கள் உருவாக்கவும். மற்ற ஆப்களில் பங்கிட்ட உள்ளடக்கத்தை ஒரு தட்டில் அரட்டைக்கு அனுப்பலாம்.</string>
    <string name="onboarding_3_bubble_in">வார இறுதி புகைப்படங்கள் தயார், அனுப்புகிறேன்</string>
    <string name="onboarding_3_bubble_out">கிடைத்தது, தரம் அருமை!</string>
    <string name="onboarding_3_share_hint">மற்ற ஆப்களில் பங்கிடு → ஒரு தட்டில் அரட்டைக்கு அனுப்பு</string>
    <string name="onboarding_4_title">கோப்பு பரிமாற்றத்திற்கு மட்டும் அல்ல</string>
    <string name="onboarding_4_body">புகைப்படம், இசை, குறிப்புகள் போன்ற பயனுள்ள கருவிகள் அனைத்தும் ஆஃப்லைனில்; இசையில் ஒத்திசைவு பாடல் வரிகள் மற்றும் சாதனத்தில் AI வரி பிரித்தெடுத்தல்.</string>
    <string name="onboarding_4_photo_title">புகைப்படங்கள் மற்றும் வீடியோக்கள்</string>
    <string name="onboarding_4_photo_desc">பார்த்து ஒழுங்கமைக்க</string>
    <string name="onboarding_4_music_title">இசை</string>
