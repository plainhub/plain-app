    <string name="onboarding_step1_title">சேவையைத் தொடங்கு</string>
    <string name="onboarding_step1_desc">PlainApp-ஐத் திறந்து முகப்புத் திரையில் சேவையைத் தொடங்கு</string>
    <string name="onboarding_step2_title">ஒரே Wi-Fi-இல் இணைக்கவும்</string>
    <string name="onboarding_step2_desc">ஃபோன் மற்றும் கணினியை ஒரே ரவுட்டரில் இணைக்கவும்</string>
    <string name="onboarding_step3_title">கணினியில் முகவரியைத் திறக்கவும்</string>
    <string name="onboarding_step3_desc">ஃபோன் திரையில் காட்டப்படும் முகவரியை உலாவியில் உள்ளிடவும்</string>
    <string name="onboarding_revisit_hint">இந்த அறிமுகத்தை எப்போது வேண்டுமானாலும் அமைப்புகள் → எப்படி பயன்படுத்துவது இல் மீண்டும் பார்க்கலாம்</string>
