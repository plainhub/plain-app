    <string name="onboarding_3_msg_sent">已全部发送，在电脑上查看吧</string>
    <string name="onboarding_3_share_hint">其他应用分享 → 一键转发到聊天</string>
    <string name="onboarding_4_title">不止传文件</string>
    <string name="onboarding_4_body">相册、音乐、笔记等实用工具，全部离线可用；音乐支持同步歌词。</string>
    <string name="onboarding_4_photo_title">照片视频</string>
    <string name="onboarding_4_photo_desc">浏览与整理</string>
    <string name="onboarding_4_music_title">音乐</string>
    <string name="onboarding_4_music_desc">同步歌词</string>
    <string name="onboarding_4_notes_desc">Markdown 编辑</string>
    <string name="onboarding_4_tools_desc">扫码 · 更多</string>
    <string name="onboarding_5_title">三步，开始使用</string>
    <string name="onboarding_step1_title">启动服务</string>
    <string name="onboarding_step1_desc">打开 PlainApp，在首页启动「服务」</string>
    <string name="onboarding_step2_title">连接同一 Wi-Fi</string>
    <string name="onboarding_step2_desc">手机与电脑连接到同一路由器</string>
    <string name="onboarding_step3_title">电脑打开地址</string>
    <string name="onboarding_step3_desc">浏览器输入手机屏幕上显示的网址</string>
    <string name="onboarding_revisit_hint">随时可在 设置 → 使用方法 重新查看</string>
    <string name="onboarding_replay">重新查看引导</string>
    <string name="wizard_connect_title">在电脑上打开手机</string>
    <string name="wizard_connect_body">让两台设备连上同一网络，在手机首页打开「远程访问」，然后在电脑浏览器输入首页显示的完整地址。</string>
    <string name="wizard_access_title">决定哪些内容可以远程访问</string>
    <string name="wizard_access_body">在首页打开「访问设置」，选择允许访问的功能。你也可以在这里管理会话和安全设置。</string>
    <string name="wizard_view_guide">查看使用方法</string>
    <string name="wizard_example_address">示例地址</string>
    <string name="guide_connect">从电脑连接手机</string>
    <string name="guide_enable">打开「远程访问」</string>
    <string name="guide_enable_desc">在手机首页打开开关，查看下方的地址。</string>
    <string name="guide_address_desc">输入完整地址，包括协议和显示的端口号。</string>
    <string name="guide_unreachable">检查两台设备是否在同一网络、手机首页的「远程访问」是否已开启。有备用地址时，可展开「尝试其他地址」。</string>
    <string name="guide_certificate">使用自签名证书时，浏览器可能显示警告。先核对浏览器中的 HTTPS 地址与手机首页显示的地址。</string>
    <string name="guide_missing_feature">为什么看不到某项功能？</string>
    <string name="guide_permissions">打开「访问设置」，检查是否允许远程访问该功能，以及手机是否已授予所需权限。</string>
</resources>
