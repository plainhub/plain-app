  appVersion: Int!
  osVersion: Int!
  channel: AppChannelType!
  permissions: [Permission!]!
  audios: [PlaylistAudio!]!
  audioMode: MediaPlayMode!
  audioCurrent: String!
  sdcardPath: String!
  usbDiskPaths: [String!]!
  internalStoragePath: String!
  downloadsDir: String!
  developerMode: Boolean!
  favoriteFolders: [FavoriteFolder!]!
