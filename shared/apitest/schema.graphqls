enum ChannelMemberStatus {
  JOINED
  PENDING
}

enum ChannelSystemMessageType {
  INVITE
  INVITE_ACCEPT
  INVITE_DECLINE
  UPDATE
  KICK
  LEAVE
}

type ChatChannel {
