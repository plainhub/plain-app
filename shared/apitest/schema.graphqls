"""Query object"""
type Query {
  appFiles(offset: Int!, limit: Int!, query: String!): [AppFile!]!
  appFileCount(query: String!): Int!
  chatChannels: [ChatChannel!]!
  notifications(offset: Int!, limit: Int!, query: String!): [Notification!]!
  notificationCount(query: String!): Int!
  docCount(query: String!): Int!
  docExtGroups: [DocExtGroup!]!
  docs(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Doc!]!
  smsBoxCounts: SmsCounts!
  sms(offset: Int!, limit: Int!, query: String!): [Sms!]!
  smsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
  smsCount(query: String!): Int!
  smsConversationCount(query: String!): Int!
  archivedSmsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
  tags(type: DataType!): [Tag!]!
  tagRelations(type: DataType!, keys: [String!]!): [TagRelation!]!
  appLogs(offset: Int!, limit: Int!, query: String!): [String!]!
  appLogPath: String!
  isScreenMirroring: Boolean!
  screenMirrorVideoCodec: ScreenMirrorVideoCodec
  screenMirrorControlEnabled: Boolean!
  screenMirrorQuality: ScreenMirrorQuality!
  """Chunk state for the client-chosen chunk-set id `fileId`, as `index:byteSize` strings."""
  uploadedChunks(fileId: String!): [String!]!
  """Current state of the merge job for `fileId`; NONE when no job was ever started."""
  mergeStatus(fileId: String!): MergeTask!
  feeds: [Feed!]!
  feedEntryCounts: [FeedEntryCount!]!
  feedEntryCount(query: String!): Int!
  feedEntry(id: ID!): FeedEntry
  feedEntries(offset: Int!, limit: Int!, query: String!): [FeedEntry!]!
  peers: [Peer!]!
  """Latest-first page of one conversation, returned oldest-to-newest so clients can render directly. `target` is the chat target id: a bare peer id (an optional `peer:` prefix is accepted), or a `channel:<id>` prefixed channel id."""
  chatItems(target: String!, offset: Int!, limit: Int!, query: String!): [ChatItem!]!
  """The most recent item of every conversation (direct and channel), newest conversation first."""
  latestChatItems: [ChatItem!]!
  audioCount(query: String!): Int!
  audioQueueItems(offset: Int!, limit: Int!, query: String!): [AudioItem!]!
  audioQueueItemCount: Int!
  audioPlayback: AudioPlayback!
  audios(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Audio!]!
  audioLyrics(path: String!): String
  audioPlaylists: [AudioPlaylist!]!
  audioPlaylistItems(id: ID!, offset: Int!, limit: Int!, query: String!): [AudioItem!]!
  audioPlaylistItemCount(id: ID!): Int!
  audioPlayHistory(offset: Int!, limit: Int!, query: String!): [AudioPlayHistory!]!
  imageCount(query: String!): Int!
  imageSearchStatus: ImageSearchStatus!
  images(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Image!]!
  callCount(query: String!): Int!
  sims: [Sim!]!
  calls(offset: Int!, limit: Int!, query: String!): [Call!]!
  noteCount(query: String!): Int!
  note(id: ID!): Note
  notes(offset: Int!, limit: Int!, query: String!): [Note!]!
  mediaBuckets(type: MediaDataType!): [MediaBucket!]!
  deviceInfo: DeviceInfo!
  deviceStatus: DeviceStatus!
  app: App!
  contactCount(query: String!): Int!
  contactSources: [ContactSource!]!
  contactGroups: [ContactGroup!]!
  contacts(offset: Int!, limit: Int!, query: String!): [Contact!]!
  isDiscovering: Boolean!
  pomodoroSettings: PomodoroSettings!
  pomodoroToday: PomodoroToday!
  dataStorePath: String!
  dataStoreEntries: [KeyValuePair!]!
  imageEditorProjects: [ImageEditorProjectSummary!]!
  imageEditorProject(id: ID!): ImageEditorProject
  packages(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Package!]!
  packageStatuses(ids: [ID!]!): [PackageStatus!]!
  packageCount(query: String!): Int!
  dbPath: String!
  dbTables: [String!]!
  dbTableRowCount(table: String!): Long!
  dbTableRows(table: String!, offset: Int!, limit: Int!): [String!]!
  dbTableColumns(table: String!): [DbTableColumn!]!
  dbTableInfo(table: String!): DbTableInfo!
  videoCount(query: String!): Int!
  videos(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Video!]!
  """Paged clipboard history, newest first."""
  clipboardItems(offset: Int!, limit: Int!, query: String!): [ClipboardItem!]!
  clipboardItemCount(query: String!): Int!
  bookmarks: [Bookmark!]!
  bookmarkGroups: [BookmarkGroup!]!
  mounts: [StorageMount!]!
  recentFiles: [File!]!
  files(root: String!, offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [File!]!
  fileCount(root: String!, query: String!): Int!
  """Detailed info for one file. `fileName` is optional — when omitted it is derived from `path`; it selects the media-info probe (image/video/audio)."""
  fileInfo(path: String!, fileName: String): FileInfo!
  fileIds(paths: [String!]!): [String!]!
  """Whether the path exists. Blank and '.' paths are false; stat errors (e.g. permission denied) count as not-there — a total predicate, never raises."""
  pathExists(path: String!): Boolean!
  """Kind of the path: FILE or DIR; null when the path does not exist (same total-predicate semantics as pathExists)."""
  pathKind(path: String!): PathKind
  favoriteFolders: [FavoriteFolder!]!
}

"""Mutation object"""
type Mutation {
  createChatChannel(name: String!): ChatChannel!
  updateChatChannel(id: ID!, name: String!): ChatChannel!
  deleteChatChannel(id: ID!): Boolean!
  leaveChatChannel(id: ID!): Boolean!
  addChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
  removeChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
  acceptChatChannelInvite(id: ID!): Boolean!
  declineChatChannelInvite(id: ID!): Boolean!
  deleteNotifications(ids: [ID!]!): ActionResult!
  """Reply to a notification. actionIndex indexes Notification.replyActions (the reply-capable subset only), NOT the plain actions list."""
  replyNotification(id: ID!, actionIndex: Int!, text: String!): Boolean!
  unarchiveSmsConversation(id: ID!): Boolean!
  """Send an SMS directly from the device. subscriptionId picks the SIM (-1 = system default, see sims); requestId is an optional idempotency key that dedupes retried sends. Returns true once the send is dispatched."""
  sendSms(number: String!, body: String!, subscriptionId: Int!, requestId: String): Boolean!
  archiveSmsConversation(id: ID!): Boolean!
  trashSms(query: String!): ActionResult!
  restoreSms(query: String!): ActionResult!
  deleteSms(query: String!): ActionResult!
  """Compose an MMS in the device's default SMS app and track the send. Returns a pendingId consumed by the mms polling/WebSocket flow — poll with it until the send resolves."""
  sendMms(number: String!, body: String!, attachmentPaths: [String!]!, threadId: ID!): String!
  createTag(type: DataType!, name: String!): Tag!
  updateTag(id: ID!, name: String!): Tag!
  deleteTag(id: ID!): Boolean!
  addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
  updateTagRelations(type: DataType!, item: TagRelationStub!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
  removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
  clearAppLogs: Boolean!
  """Initiate pairing with a discovered LAN device."""
  pairDevice(input: PairingDeviceInput!): Boolean!
  """Cancel an in-progress pairing initiated by this device."""
  cancelPairing(deviceId: ID!): Boolean!
  """Respond to an incoming pairing request — accept or reject."""
  respondToPairing(input: PairingRequestInput!, accepted: Boolean!): Boolean!
  startScreenMirror(audio: Boolean!): Boolean!
  requestScreenMirrorAudio: Boolean!
  stopScreenMirror: Boolean!
  updateScreenMirrorQuality(mode: ScreenMirrorMode!): Boolean!
  sendScreenMirrorControl(input: ScreenMirrorControlInput!): Boolean!
  requestScreenMirrorKeyFrame: Boolean!
  """Delete all uploaded chunks for `fileId`, discarding an unfinished upload."""
  deleteChunks(fileId: String!): Boolean!
  """Start a background merge of the uploaded chunks into the file at `path`; completion arrives via the upload_merge_result WS event, `mergeStatus` is the polling fallback. `replace=false` keeps the existing file and writes to a new sibling path instead; the summed chunk sizes must match `totalSize`."""
  mergeChunks(fileId: String!, totalChunks: Int!, path: String!, replace: Boolean!, totalSize: Long!): MergeTask!
  """Background merge into the app-private content store; `fileName` is a name hint (no directory), always overwrites. Returns a MergeTask — poll mergeStatus or wait for the upload_merge_result WS event."""
  mergeAppFileChunks(fileId: String!, totalChunks: Int!, fileName: String!, totalSize: Long!): MergeTask!
  deleteFiles(paths: [String!]!): ActionResult!
  createDir(path: String!): File!
  renameFile(path: String!, name: String!): Boolean!
  writeTextFile(path: String!, content: String!, overwrite: Boolean!): File!
  copyFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
  moveFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
  addFavoriteFolder(rootPath: String!, fullPath: String!): [FavoriteFolder!]!
  removeFavoriteFolder(fullPath: String!): [FavoriteFolder!]!
  setFavoriteFolderAlias(fullPath: String!, alias: String!): [FavoriteFolder!]!
  """Queue a feed content sync. `id` is optional: omit it (null) to sync all feeds, or pass one feed id to sync only that feed."""
  syncFeeds(id: ID): Boolean!
  updateFeed(id: ID!, name: String!, fetchContent: Boolean!): Feed!
  createFeed(url: String!, fetchContent: Boolean!): Feed!
  importFeeds(content: String!): Boolean!
  exportFeeds: String!
  deleteFeed(id: ID!): Boolean!
  syncFeedEntryContent(id: ID!): FeedEntry!
  deleteFeedEntries(query: String!): ActionResult!
  deletePeer(id: ID!): Boolean!
  unpairPeer(id: ID!): Boolean!
  """Send a chat message. `target` is the chat target id — a bare peer id (an optional `peer:` prefix is accepted), or a `channel:<id>` prefixed channel id; same value space as the chatItems query. `content` is the message envelope JSON ({type: TEXT|IMAGES|FILES|SHARE, value: {...}}), same shape as ChatItem.content."""
  sendChatItem(target: String!, content: String!): [ChatItem!]!
  deleteChatItem(id: ID!): Boolean!
  deleteChatItems(query: String!): ActionResult!
  retryChatItem(id: ID!): ChatItem!
  playAudio(path: String!): AudioItem!
  updateAudioPlayMode(mode: MediaPlayMode!): Boolean!
  clearAudioQueue: Boolean!
  removeAudioFromQueue(path: String!): Boolean!
  addAudiosToQueue(query: String!): Boolean!
  reorderAudioQueue(paths: [String!]!): Boolean!
  createAudioPlaylist(name: String!): AudioPlaylist!
  updateAudioPlaylist(id: ID!, name: String!): AudioPlaylist!
  deleteAudioPlaylist(id: ID!): Boolean!
  addAudioPlaylistItems(id: ID!, paths: [String!]!): Boolean!
  removeAudioPlaylistItem(id: ID!, path: String!): Boolean!
  """Start playback of a playlist. `path` optionally names the audio to start from (defaults to the first item); `shuffle` reorders before playing. Returns the item that starts playing, null when the playlist is empty."""
  playAudioPlaylist(id: ID!, path: String, shuffle: Boolean!): AudioItem
  """Queue the whole audio library and start playback (first track, or shuffled order when `shuffle` is set). Returns the item that starts playing, null when the library is empty."""
  playAllAudios(shuffle: Boolean!): AudioItem
  enableImageSearch: Boolean!
  disableImageSearch: Boolean!
  cancelImageModelDownload: Boolean!
  startImageIndex(force: Boolean): Boolean!
  cancelImageIndex: Boolean!
  call(number: String!, showDialer: Boolean!): Boolean!
  deleteCalls(query: String!): ActionResult!
  createNote(input: NoteInput!): Note!
  updateNote(id: ID!, input: NoteInput!): Note!
  saveFeedEntriesToNotes(query: String!): [ID!]!
  trashNotes(query: String!): ActionResult!
  restoreNotes(query: String!): ActionResult!
  deleteNotes(query: String!): ActionResult!
  exportNotes(query: String!): String!
  deleteMediaItems(type: MediaDataType!, query: String!): ActionResult!
  trashMediaItems(type: MediaDataType!, query: String!): ActionResult!
  restoreMediaItems(type: MediaDataType!, query: String!): ActionResult!
  moveMediaItems(type: MediaDataType!, query: String!, destDir: String!): ActionResult!
  setTempValue(key: String!, value: String!): KeyValuePair!
  relaunchApp: Boolean!
  openAccessibilitySettings: Boolean!
  openWebSettings(feature: WebSettingsFeature): Boolean!
  updateDeviceName(name: String!): Boolean!
  deleteContacts(query: String!): ActionResult!
  updateContact(id: ID!, input: ContactInput!): Contact!
  createContact(input: ContactInput!): Contact!
  createContactGroup(name: String!, accountName: String!, accountType: String!): ContactGroup!
  updateContactGroup(id: ID!, name: String!): ContactGroup!
  deleteContactGroup(id: ID!): Boolean!
  startDiscovery: Boolean!
  stopDiscovery: Boolean!
  startPomodoro(durationSec: Int!): Boolean!
  pausePomodoro: Boolean!
  stopPomodoro: Boolean!
  deleteDataStoreEntry(key: String!): Boolean!
  saveImageEditorProject(id: ID!, input: ImageEditorProjectInput!): ImageEditorProject!
  deleteImageEditorProject(id: ID!): Boolean!
  broadcastImageEditorUpdate(id: ID!, update: String!): Boolean!
  uninstallPackages(ids: [ID!]!): Boolean!
  installPackage(path: String!): PackageInstallPending!
  createDbTableRow(table: String!, row: String!): Boolean!
  deleteDbTableRows(table: String!, ids: [String!]!): Boolean!
  """Write text into the system clipboard and record it in the history with the calling client as source; an identical latest entry is skipped (hash dedup)."""
  setClipboard(text: String!): Boolean!
  """Delete clipboard history entries matching the query DSL (ids:/text:, bare word = text LIKE); blank query is rejected — send all:true to clear the whole history."""
  deleteClipboardItems(query: String!): ActionResult!
  addBookmarks(urls: [String!]!, groupId: ID!): [Bookmark!]!
  updateBookmark(id: ID!, input: BookmarkInput!): Bookmark!
  deleteBookmarks(ids: [ID!]!): ActionResult!
  recordBookmarkClick(id: ID!): Boolean!
  createBookmarkGroup(name: String!): BookmarkGroup!
  updateBookmarkGroup(id: ID!, name: String!, collapsed: Boolean!, sortOrder: Int!): BookmarkGroup!
  deleteBookmarkGroup(id: ID!): Boolean!
}

type ActionResult {
  affectedCount: Int!
}

type AndroidExtras {
  sdkVersion: Int!
  versionCodeName: String!
  securityPatch: String!
  bootloader: String!
  fingerprint: String!
  hardware: String!
  radioVersion: String!
  board: String!
  buildBrand: String!
  buildNumber: String!
  device: String!
  javaVmVersion: String!
  glEsVersion: String!
  buildTime: Instant!
}

type App {
  clientId: String!
  """Base64 key used to encrypt/decrypt URL parameters for this server's web access (see file display URLs). Treat as a secret for the current session."""
  urlToken: String!
  httpPort: Int!
  httpsPort: Int!
  appDir: String!
  deviceName: String!
  deviceType: DeviceType!
  capabilities: [Capability!]!
  buildChannel: AppChannelType!
  permissions: [Permission!]!
  downloadsDir: String!
  developerMode: Boolean!
  debug: Boolean!
}

enum AppChannelType {
  GITHUB
  GOOGLE
  FDROID
}

type AppFile {
  """Content-addressable fileId (the fid suffix, `{sha256}[.{ext}]`); same value space as ChatFiles.ids/ChatImages.ids."""
  id: String!
  size: Long!
  mimeType: String!
  realPath: String!
  fileName: String!
  createdAt: Instant!
  updatedAt: Instant!
}

type Audio implements MediaItem {
  id: ID!
  title: String!
  artist: String!
  path: String!
  durationMs: Long!
  size: Long!
  bucketId: ID!
  """FileId of the album-art image, usable in file display URLs; empty when the track has no album art."""
  albumFileId: String!
  createdAt: Instant!
  updatedAt: Instant!
  isFavorite: Boolean!
  tags: [Tag!]!
}

type AudioFileInfo {
  durationMs: Long!
  location: Location
}

type AudioItem {
  title: String!
  artist: String!
  path: String!
  durationMs: Long!
}

type AudioPlayHistory {
  path: String!
  title: String!
  artist: String!
  durationMs: Long!
  playCount: Long!
  playedAt: Instant!
}

type AudioPlayback {
  currentPath: String
  mode: MediaPlayMode!
  isPlaying: Boolean!
  positionMs: Long!
}

type AudioPlaylist {
  id: ID!
  name: String!
  itemCount: Int!
  createdAt: Instant!
  updatedAt: Instant!
}

type Bookmark {
  id: ID!
  url: String!
  title: String!
  faviconPath: String!
  groupId: ID!
  pinned: Boolean!
  clickCount: Int!
  lastClickedAt: Instant
  sortOrder: Int!
  createdAt: Instant!
  updatedAt: Instant!
}

type BookmarkGroup {
  id: ID!
  name: String!
  collapsed: Boolean!
  sortOrder: Int!
  itemCount: Int!
  createdAt: Instant!
  updatedAt: Instant!
}

input BookmarkInput {
  url: String!
  title: String!
  groupId: ID!
  pinned: Boolean!
  sortOrder: Int!
}

type Call {
  id: ID!
  number: String!
  name: String!
  photoId: String!
  startedAt: Instant!
  durationSec: Int!
  type: CallType!
  accountId: ID!
  geo: PhoneGeo
  tags: [Tag!]!
}

enum CallType {
  INCOMING
  OUTGOING
  MISSED
  VOICEMAIL
  REJECTED
  BLOCKED
  ANSWERED_EXTERNALLY
  UNKNOWN
}

"""Whether the device (server) itself provides this capability — e.g. a NAS has no SMS, so it omits SMS from App.capabilities. Clients gate UI on App.capabilities instead of sniffing OS versions; this says nothing about client-side access rights, which are App.permissions (Permission)."""
enum Capability {
  MEDIA_TRASH
  MIRROR_AUDIO
  DOC_PREVIEW
  IMAGE_SEARCH
  MEDIA_SCAN
  SMS
  CALLS
  CALL_PHONE
  CONTACTS
  PACKAGES
  NOTES
  FEEDS
  SCREEN_MIRROR
  IMAGE_EDITOR
  NOTIFICATIONS
  CLIPBOARD
  POMODORO
}

type Certificate {
  issuer: String!
  subject: String!
  serialNumber: String!
  validFrom: Instant!
  validTo: Instant!
}

enum ChannelMemberStatus {
  JOINED
  PENDING
}

enum ChannelSystemMessageType {
  INVITE
  INVITE_ACCEPT
  INVITE_DECLINE
  UPDATE
  KICK
  LEAVE
}

type ChatChannel {
  id: ID!
  ownerId: ID!
  name: String!
  members: [ChatChannelMember!]!
  """Monotonically increasing mutation counter; receivers ignore channel updates whose version is not greater than their local copy."""
  version: Long!
  status: ChatChannelStatus!
  createdAt: Instant!
  updatedAt: Instant!
}

type ChatChannelMember {
  peerId: ID!
  status: ChannelMemberStatus!
}

enum ChatChannelStatus {
  JOINED
  LEFT
  KICKED
}

type ChatFiles {
  ids: [String!]!
}

type ChatImages {
  ids: [String!]!
}

type ChatItem {
  """`me` when this device created the item, otherwise the client id of the originating peer."""
  fromId: ID!
  """Peer id for direct messages; empty for channel messages — `channelId` is authoritative there."""
  toId: ID!
  channelId: ID
  id: ID!
  """Message envelope JSON: {type: TEXT|IMAGES|FILES|SHARE, value: {...}} — parse `value` according to `type`; the typed payload is also mirrored in `data`."""
  content: String!
  createdAt: Instant!
  updatedAt: Instant!
  status: ChatStatus!
  """Per-recipient delivery details as JSON (peer delivery results); empty when the message has no delivery failures. Drives SENT/PARTIAL/FAILED alongside `status`."""
  statusData: String!
  data: ChatItemContent
}

union ChatItemContent = ChatFiles | ChatImages | ChatText

enum ChatStatus {
  SENT
  PARTIAL
  FAILED
  PENDING
}

type ChatText {
  linkPreviewImageIds: [String!]!
}

type ClipboardItem {
  id: ID!
  text: String!
  """Client id of the sync origin: empty = captured locally on this device, otherwise received from that peer."""
  source: String!
  label: String!
  sensitive: Boolean!
  createdAt: Instant!
}

type Contact {
  id: ID!
  prefix: String!
  firstName: String!
  middleName: String!
  lastName: String!
  suffix: String!
  nickname: String!
  photoId: String!
  phoneNumbers: [ContactPhoneNumber!]!
  emails: [ContactEmail!]!
  addresses: [ContactAddress!]!
  events: [ContactEvent!]!
  source: String!
  starred: Boolean!
  contactId: ID!
  thumbnailId: String!
  notes: String!
  groups: [ContactGroup!]!
  organization: Organization
  websites: [ContactWebsite!]!
  ims: [ContactIm!]!
  ringtone: String!
  updatedAt: Instant!
  tags: [Tag!]!
}

type ContactAddress {
  value: String!
  type: PostalType!
  label: String!
}

input ContactAddressInput {
  value: String!
  type: PostalType!
  label: String!
}

type ContactEmail {
  value: String!
  type: EmailType!
  label: String!
}

input ContactEmailInput {
  value: String!
  type: EmailType!
  label: String!
}

type ContactEvent {
  value: String!
  type: EventType!
  label: String!
}

input ContactEventInput {
  value: String!
  type: EventType!
  label: String!
}

type ContactGroup {
  id: ID!
  name: String!
  contactCount: Int!
}

type ContactIm {
  value: String!
  protocol: ImProtocol!
  customProtocol: String!
}

input ContactImInput {
  value: String!
  protocol: ImProtocol!
  customProtocol: String!
}

input ContactInput {
  prefix: String!
  firstName: String!
  middleName: String!
  lastName: String!
  suffix: String!
  nickname: String!
  phoneNumbers: [ContactPhoneInput!]!
  emails: [ContactEmailInput!]!
  addresses: [ContactAddressInput!]!
  events: [ContactEventInput!]!
  source: String!
  starred: Boolean!
  notes: String!
  groupIds: [ID!]!
  organization: OrganizationInput
  websites: [ContactWebsiteInput!]!
  ims: [ContactImInput!]!
}

input ContactPhoneInput {
  value: String!
  type: PhoneType!
  label: String!
}

type ContactPhoneNumber {
  value: String!
  type: PhoneType!
  label: String!
  normalizedNumber: String!
}

type ContactSource {
  name: String!
  type: String!
}

type ContactWebsite {
  value: String!
  type: WebsiteType!
  label: String!
}

input ContactWebsiteInput {
  value: String!
  type: WebsiteType!
  label: String!
}

"""Taggable data domains. The four media members (AUDIO/VIDEO/IMAGE/DOC) are exactly MediaDataType; a single variable cannot span both enums, so documents mixing e.g. tags(type: DataType!) with mediaBuckets(type: MediaDataType!) must declare one variable per enum."""
enum DataType {
  DEFAULT
  AUDIO
  VIDEO
  IMAGE
  SMS
  CONTACT
  NOTE
  FEED_ENTRY
  CALL
  PACKAGE
  FILE
  APP_FILE
  DOC
}

"""Declared column type for dbTableColumns.dataType; UNKNOWN covers undeclared columns and declared types outside SQLite's standard set."""
enum DbColumnType {
  TEXT
  INTEGER
  REAL
  BLOB
  NUMERIC
  UNKNOWN
}

type DbTableColumn {
  name: String!
  dataType: DbColumnType!
  notNull: Boolean!
  defaultValue: String
  primaryKey: Boolean!
}

type DbTableInfo {
  idKey: String!
}

type DeviceInfo {
  name: String!
  platform: DevicePlatform!
  manufacturer: String!
  model: String!
  osName: String!
  osVersion: String!
  kernelVersion: String!
  appVersion: String!
  appBuildNumber: String!
  language: String!
  cpuArch: String!
  cpuModel: String
  totalMemory: Long!
  totalStorage: Long!
  display: DisplayInfo
  """Android-only build/runtime details; null on non-Android devices."""
  android: AndroidExtras
}

enum DevicePlatform {
  ANDROID
  IOS
  MACOS
  WINDOWS
  LINUX
}

type DeviceStatus {
  uptimeSec: Long!
  """Battery percentage; null on devices without a battery (desktop/NAS)."""
  batteryLevel: Int
  charging: Boolean!
  temperatures: [Temperature!]!
  cpuUsage: Float!
  """Available memory in bytes; null when the platform cannot report it."""
  memoryAvailable: Long
  storageAvailable: Long!
}

enum DeviceType {
  COMPUTER
  PHONE
  TABLET
  TV
  NAS
  OTHER
}

enum DiscoveryMethod {
  LAN
  BLE
  QR
}

type DisplayInfo {
  width: Int!
  height: Int!
  density: Float!
}

type Doc implements MediaItem {
  id: ID!
  title: String!
  path: String!
  extension: String!
  size: Long!
  bucketId: ID!
  createdAt: Instant!
  updatedAt: Instant!
  tags: [Tag!]!
}

type DocExtGroup {
  ext: String!
  count: Int!
}

enum DriveType {
