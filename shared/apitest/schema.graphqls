}

"""ISO-8601 / RFC 3339 UTC timestamp string, e.g. 2026-09-20T12:34:56.789Z"""
scalar Instant

type KeyValuePair {
  key: String!
  value: String!
}

type Location {
  latitude: Float!
  longitude: Float!
}

"""The Long scalar type represents a signed 64-bit numeric non-fractional value"""
scalar Long

type MediaBucket {
  id: ID!
  name: String!
  itemCount: Int!
