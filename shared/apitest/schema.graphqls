type Notification {
  id: ID!
  """Android FLAG_ONLY_ALERT_ONCE: re-posted updates must not sound/vibrate again."""
  onlyOnce: Boolean!
  isClearable: Boolean!
  appId: ID!
  appName: String!
  postedAt: Instant!
  silent: Boolean!
  title: String!
  body: String!
  actions: [String!]!
  """Subset of `actions` that support inline reply; `replyNotification`'s `actionIndex` indexes this list, not `actions`."""
  replyActions: [String!]!
}

