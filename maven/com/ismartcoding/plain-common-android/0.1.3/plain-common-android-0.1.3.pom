  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ismartcoding</groupId>
  <artifactId>plain-common-android</artifactId>
  <version>0.1.3</version>
  <packaging>aar</packaging>
  <name>plain-common</name>
  <description>Reusable Kotlin Multiplatform utilities and server components from PlainApp</description>
  <url>https://github.com/plainhub/plain-app</url>
  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:git://github.com/plainhub/plain-app.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/plainhub/plain-app.git</developerConnection>
    <url>https://github.com/plainhub/plain-app</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.19.1</version>
      <scope>compile</scope>
    </dependency>
